{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "build and run",
            "type": "shell",
            "command": "g++ -g ${file} -o ${fileDirname}\\${fileBasenameNoExtension}.exe; if ($?) { ${fileDirname}\\${fileBasenameNoExtension}.exe }",
            "group": "test",
            "problemMatcher": "$gcc"
        }
    ]
}
